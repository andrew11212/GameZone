@model IEnumerable<GameZone.Models.Game>

@{
    ViewData["Title"] = "Game Management";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary"><i class="bi bi-grid-3x3-gap-fill"></i> Game Management</h1>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle-fill me-1"></i> Add New Game
        </a>
    </div>

    <div class="row g-3 mb-5">
        @if (Model.Any())
        {
            foreach (var game in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card h-100 shadow">
                        <div class="position-relative">
                            <a asp-action="Details" asp-route-id="@game.id">
                                <img src="@Url.Content($"~/{FileSetting.ImagePath}/{game.cover}")" alt="@game.name" class="card-img-top" style="height: 160px; object-fit: cover;" />
                            </a>
                            <div class="position-absolute top-0 end-0 p-2">
                                <span class="badge bg-primary">@game.Category?.Name</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">
                                <a asp-action="Details" asp-route-id="@game.id" class="text-decoration-none text-dark">
                                    @game.name
                                </a>
                            </h5>
                            <p class="card-text text-truncate mb-3">@game.description</p>
                            <div class="btn-group w-100">
                                <a asp-action="Details" asp-route-id="@game.id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-info-circle-fill me-1"></i> Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@game.id" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil-fill me-1"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@game.id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash-fill me-1"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle-fill me-2"></i> No games available. Click "Add New Game" to create one.
                </div>
            </div>
        }
    </div>
</div>
