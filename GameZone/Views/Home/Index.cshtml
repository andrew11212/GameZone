@model IEnumerable<Game>

@{
    ViewData["Title"] = "Games Collection";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 text-center text-primary"><i class="bi bi-joystick"></i> Featured Games</h1>
            <p class="lead text-center text-muted">Discover our collection of amazing games</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        @foreach (var game in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 shadow">
                    <a asp-controller="Games" asp-action="Details" asp-route-id="@game.id" class="text-decoration-none">
                        <div class="card-img-top" style="background-image: url('@($"{FileSetting.ImagePath.Trim()}/{game.cover}")'); height: 300px; background-size: cover; background-position: center;">
                            <div class="d-flex p-3">
                                <span class="badge bg-primary">@game.Category.Name</span>
                            </div>
                        </div>
                    </a>
                    <div class="card-body">
                        <h4 class="card-title fw-bold">
                            <a asp-controller="Games" asp-action="Details" asp-route-id="@game.id" class="text-decoration-none text-dark">
                                @game.name
                            </a>
                        </h4>
                        <p class="card-text text-truncate">@game.description</p>
                        <div class="mb-3 fs-4">
                            @foreach (var gamedevise in game.Devises)
                            {
                                <i class="@gamedevise.Device.Icon me-1" data-bs-toggle="tooltip" title="@gamedevise.Device.Name"></i>
                            }
                        </div>
                        <a asp-controller="Games" asp-action="Details" asp-route-id="@game.id" class="btn btn-outline-primary btn-sm rounded-pill">
                            <i class="bi bi-info-circle-fill me-1"></i> Game Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
}
